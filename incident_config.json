    "participants": [
      {"id": "a", "name": "Manager", "type": "actor"},
      {"id": "ui", "name": "Incident Management Screen", "type": "screen"},
      {"id": "c", "name": "IncidentReportsController", "type": "system"},
      {"id": "s", "name": "IncidentReportService", "type": "system"},
