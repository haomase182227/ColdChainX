      {"type": "msg", "from": "ui", "to": "a", "label": "11. Transload Confirmed", "return": true}
    ]
  },
  {
    "title": "Update Trip Status Sequence Diagram",
    "participants": [
      {"id": "a", "name": "Driver", "type": "actor"},
      {"id": "ui", "name": "Driver Mobile App", "type": "screen"},
      {"id": "c", "name": "IncidentReportsController", "type": "system"},
      {"id": "s", "name": "IncidentRescueService", "type": "system"},
      {"id": "tp", "name": "MQTT", "type": "thirdparty"},
